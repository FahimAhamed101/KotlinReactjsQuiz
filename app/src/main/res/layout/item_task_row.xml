<?xml version="1.0" encoding="utf-8"?>
<!--
  One queued task, as listed under "Other tasks" on the Tasks screen.

  Read-only on purpose. The queue order and the skip accounting belong to the server, so
  letting someone tap a row to jump ahead would silently desync the two — this list exists
  so the next few tasks are visible, not to reorder them.

  A flat row with a hairline under it, not a card: seven of these stack up, and seven
  cards turn the section into a second page of chrome that competes with the live card
  above it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
          The glyph names the action, the same visual shorthand the reference uses: a heart
          for a like task, a person for a follow. Swapped per row in QueuedTaskAdapter.
          Tinted here so both glyphs land on the same cyan — the heart already carries it,
          the person mark does not.
        -->
        <ImageView
            android:id="@+id/iv_other_task_glyph"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tk_heart"
            android:tint="@color/tk_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_other_task_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/tk_text_secondary"
                android:textSize="14sp"
                tools:text="Like" />

            <TextView
                android:id="@+id/tv_other_task_handle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/tk_text_secondary"
                android:textSize="14sp"
                tools:text="@nethra078" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_other_task_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tk_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="2" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/coins_label"
            android:src="@drawable/ic_coin"
            android:tint="@color/tk_gold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tk_divider" />
</LinearLayout>
