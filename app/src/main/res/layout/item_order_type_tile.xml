<?xml version="1.0" encoding="utf-8"?>
<!--
  One tile in the "What do you want to order?" grid.

  Selection is expressed through `tt_order_tile_bg`, so the grid only has to flip
  `isSelected` on the tiles it touches. The icon/label colours are set in code for the
  same reason — a selected tile turns cyan, matching the reference app.

  The "Soon" badge sits over the top-end corner and is only shown for order types the
  backend cannot actually deliver (see `OrderTypes`).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/tt_order_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingTop="24dp"
    android:paddingEnd="10dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_order_type_icon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:contentDescription="@null"
            app:tint="@color/tt_text_primary"
            tools:src="@drawable/ic_heart" />

        <TextView
            android:id="@+id/tv_order_type_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/tt_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold"
            tools:text="Likes" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_order_type_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:background="@drawable/tt_pill_dark"
        android:paddingStart="7dp"
        android:paddingTop="2dp"
        android:paddingEnd="7dp"
        android:paddingBottom="2dp"
        android:text="@string/tt_order_type_soon"
        android:textColor="@color/tt_text_secondary"
        android:textSize="8.5sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
