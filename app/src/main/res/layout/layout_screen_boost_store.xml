<?xml version="1.0" encoding="utf-8"?>
<!--
  The "New order" screen (the Boost tab).

  Rebuilt to match the reference app: a "What do you want to order?" heading over a
  two-column grid of order-type tiles, then the target picker, then the packages.

  Everything above the package list used to be a two-tab selector (Profile / Video).
  The tabs are gone: the grid *is* the selector now, and it carries all five order types
  the reference app offers rather than only the two we can deliver.

  One scrolling surface, so the grid, the picker and the package list never fight for
  the screen — the same arrangement the More screen uses, for the same reason. The inner
  RecyclerViews therefore all have nested scrolling off and wrap_content height.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="80dp">

        <!-- ===================== Heading ===================== -->
        <TextView
            android:id="@+id/tv_new_order_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="@string/tt_new_order_title"
            android:textColor="@color/tt_text_primary"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- ===================== Order-type grid =====================
             Negative side margins cancel the tile's own 5dp margin at the outer edges,
             so the grid lines up with the 16dp page gutter while keeping a 10dp gutter
             between tiles. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_order_types"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-5dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="-5dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            tools:itemCount="5"
            tools:listitem="@layout/item_order_type_tile" />

        <!-- ===================== Target picker (post-scoped types) ===================== -->
        <LinearLayout
            android:id="@+id/card_video_target_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_target_section_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tt_new_order_target_title"
                    android:textColor="@color/tt_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_how_to_find_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:lineSpacingExtra="1dp"
                    android:text="@string/tt_new_order_how_to_find"
                    android:textColor="@color/tt_teal"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Link field + paste button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/tt_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_order_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/tt_new_order_link_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="13dp"
                    android:textColor="@color/tt_text_primary"
                    android:textColorHint="@color/tt_text_secondary"
                    android:textSize="13.5sp" />

                <ImageView
                    android:id="@+id/btn_paste_order_link"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="13dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/tt_new_order_target_title"
                    android:focusable="true"
                    android:padding="3dp"
                    android:src="@drawable/ic_copy"
                    android:tint="@color/tt_teal" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_order_link_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/tt_tip_red"
                android:textSize="11.5sp"
                android:visibility="gone"
                tools:text="That does not look like a video link"
                tools:visibility="visible" />

            <!-- The account's own posts, so a link is not the only way in. -->
            <TextView
                android:id="@+id/tv_order_videos_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/tt_new_order_videos_title"
                android:textColor="@color/tt_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_order_videos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:indeterminateTint="@color/tt_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_order_videos_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tt_new_order_no_videos"
                android:textColor="@color/tt_text_secondary"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_order_videos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:scrollbars="none" />
        </LinearLayout>

        <!-- ===================== Profile-scoped note (Followers) ===================== -->
        <TextView
            android:id="@+id/tv_profile_target_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/tt_text_secondary"
            android:textSize="12.5sp"
            android:visibility="gone"
            tools:text="Followers are added to your own profile @demo. Nothing to paste."
            tools:visibility="visible" />

        <!-- ===================== Unsupported-type note ===================== -->
        <TextView
            android:id="@+id/tv_order_type_unavailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/tt_text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Only Followers and Likes can be delivered by this server."
            tools:visibility="visible" />

        <!-- ===================== Packages ===================== -->
        <TextView
            android:id="@+id/tv_packages_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Choose a package"
            android:textColor="@color/tt_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_boost"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/tt_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_boost_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/tt_boost_loading"
            android:textColor="@color/tt_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_boost_products"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            tools:listitem="@layout/item_boost_row" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
