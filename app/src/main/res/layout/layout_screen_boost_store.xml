<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:background="@android:color/transparent">

    <!-- SocialBoost Sub-Tabs: Profile vs Video (Pinned at top) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="18dp"
        app:strokeWidth="0dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_cosmic_gradient"
            android:orientation="horizontal">

            <!-- Profile Tab (Followers) -->
            <LinearLayout
                android:id="@+id/tab_boost_profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_tab_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="@color/tt_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indicator_tab_profile"
                    android:layout_width="match_parent"
                    android:layout_height="3.5dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/tt_tab_indicator" />
            </LinearLayout>

            <!-- Video Tab (Likes) -->
            <LinearLayout
                android:id="@+id/tab_boost_video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_tab_video"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Video"
                    android:textColor="@color/tt_text_secondary"
                    android:textSize="17sp" />

                <View
                    android:id="@+id/indicator_tab_video"
                    android:layout_width="match_parent"
                    android:layout_height="3.5dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/tt_tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Video Selection Bar (optional, hidden by default) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_video_target_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="18dp"
        app:strokeWidth="0dp"
        app:cardElevation="2dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_cosmic_gradient"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_heart"
                app:tint="@color/tt_accent"
                android:contentDescription="Video Likes" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/tv_selected_video_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Video to Boost ❤️"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/tt_text_primary" />

                <TextView
                    android:id="@+id/tv_selected_video_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to select your video or paste a link"
                    android:textSize="11sp"
                    android:textColor="@color/tt_text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change ➔"
                android:textColor="@color/tt_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progress_boost"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="@color/tt_accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_boost_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/tt_boost_loading"
        android:textSize="13sp"
        android:textColor="@color/tt_text_secondary"
        android:visibility="gone" />

    <!-- Vertical Package List matching SocialBoost screenshots: native smooth scroll -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_boost_products"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="72dp"
        android:scrollbars="none"
        android:overScrollMode="ifContentScrolls"
        tools:listitem="@layout/item_boost_row" />

</LinearLayout>
