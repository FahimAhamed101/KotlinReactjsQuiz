<?xml version="1.0" encoding="utf-8"?>
<!--
  Home shell.

  Top bar mirrors SocialBoost: avatar on the left, the SocialBoost wordmark centred
  (TT in white, Boost in pink), the coin pill on the right.

  The bottom navigation is owned by the shell (not by an individual screen) so
  it stays visible on every tab — the reference app behaves the same way.

  The ViewFlipper holds the two screens:
    0 = Tasks     (the SocialBoost Home feed — replaced the old quiz)
    1 = Store     (TikTok boost packages paid with coins + the code catalogue)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tt_bg_aurora"
    android:orientation="vertical">

    <!-- ======================= Top bar ======================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/tt_top_bar_gradient"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- Profile avatar with the gradient ring -->
        <FrameLayout
            android:id="@+id/btn_profile"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/tt_avatar_ring"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_top_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tt_surface_elevated"
                android:contentDescription="Profile"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/TTCircleImage" />

            <!-- Switch account badge matching SocialBoost reference -->
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/badge_switch_account"
                android:src="@drawable/ic_switch_arrows"
                android:padding="2.5dp"
                app:tint="@color/white"
                android:contentDescription="Switch Account" />
        </FrameLayout>

        <!-- Center Wordmark / Title Frame -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <!-- SocialBoost wordmark -->
            <LinearLayout
                android:id="@+id/layout_top_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tt_wordmark_tt"
                    android:textColor="@color/tt_text_primary"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tt_wordmark_boost"
                    android:textColor="@color/cta_start"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/badge_discount_flame"
                    android:text="PRO"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <!-- Screen Title (e.g. Store) -->
            <TextView
                android:id="@+id/tv_top_screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Store"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Coin pill with star coin icon -->
        <LinearLayout
            android:id="@+id/chip_coins"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/tt_coin_pill_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Coins"
                android:src="@drawable/ic_star_coin" />

            <TextView
                android:id="@+id/tv_coins_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0"
                android:textColor="@color/tt_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kept for the greeting binding; hidden in the SocialBoost shell. -->
        <TextView
            android:id="@+id/tv_home_greeting"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ======================= Screens ======================= -->
    <ViewFlipper
        android:id="@+id/view_flipper_screens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Screen 0: Tasks -->
        <include
            android:id="@+id/include_screen_tasks"
            layout="@layout/layout_screen_tasks" />

        <!-- Screen 1: Boost Store (TikTok Followers, Likes & Coin Packs) -->
        <include
            android:id="@+id/include_screen_boost"
            layout="@layout/layout_screen_boost_store" />

        <!-- Screen 2: Codes Store (Source Codes Catalog + $5 Subscription) -->
        <include
            android:id="@+id/include_screen_buy_codes"
            layout="@layout/layout_screen_buy_codes" />

        <!-- Screen 3: More (Profile, Orders, Coins Ledger) -->
        <include
            android:id="@+id/include_screen_more"
            layout="@layout/layout_screen_more" />

    </ViewFlipper>

    <!-- ======================= Bottom navigation ======================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav_gradient"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Tasks (Home) -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Tasks"
                android:src="@drawable/ic_home"
                app:tint="@color/tt_pink" />

            <TextView
                android:id="@+id/tv_nav_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tasks"
                android:textColor="@color/tt_pink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Store (Likes & Followers) -->
        <LinearLayout
            android:id="@+id/nav_boost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_boost"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Store"
                android:src="@drawable/ic_person_add"
                app:tint="@color/tt_text_secondary" />

            <TextView
                android:id="@+id/tv_nav_boost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Store"
                android:textColor="@color/tt_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Codes Store (Source Codes) -->
        <LinearLayout
            android:id="@+id/nav_codes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_codes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Codes"
                android:src="@drawable/ic_code"
                app:tint="@color/tt_text_secondary" />

            <TextView
                android:id="@+id/tv_nav_codes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Codes"
                android:textColor="@color/tt_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- More -->
        <LinearLayout
            android:id="@+id/nav_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_nav_more"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="More"
                android:src="@drawable/ic_more"
                app:tint="@color/tt_text_secondary" />

            <TextView
                android:id="@+id/tv_nav_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tt_nav_more"
                android:textColor="@color/tt_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
