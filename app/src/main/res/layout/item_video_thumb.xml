<?xml version="1.0" encoding="utf-8"?>
<!--
  One of your videos, in the horizontal strip on the New order screen.

  The 3-column dialog card (item_video_card) is 180dp tall and match_parent wide, which
  is wrong for a strip; this is a fixed-width thumbnail with the like count burned into
  the bottom edge, the way the reference app shows it.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="104dp"
    android:layout_height="132dp"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/tt_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/tt_divider"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_order_video_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/tt_surface"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B3010B1F"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="5dp"
            android:paddingEnd="6dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_order_video_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="133.1k" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
