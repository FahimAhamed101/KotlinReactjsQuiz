<?xml version="1.0" encoding="utf-8"?>
<!--
  Tasks screen — the SocialBoost Home.

  Layout mirrors the reference screenshot top to bottom:
    centred avatar inside a blue->pink gradient ring
    @username underneath
    Skip  |  Follow +5 (pink, with the coin mark)
    Tips card (numbered steps + the unfollow warning)
    bottom navigation: Home / Store / More
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- ======================= Task area ======================= -->
    <!--
      SwipeRefreshLayout wraps the whole task area so the empty state's
      "Pull to retry" is a real gesture. It previously said "pull" while nothing
      listened for the swipe, so a failed load left the screen stuck.
    -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <!-- Loading / empty state -->
        <LinearLayout
            android:id="@+id/layout_task_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progress_task_loading"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminateTint="@color/tt_accent" />

            <TextView
                android:id="@+id/tv_task_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Loading tasks…"
                android:textColor="@color/tt_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- The task itself -->
        <ScrollView
            android:id="@+id/scroll_task"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <!-- Avatar in its gradient ring -->
                <FrameLayout
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/tt_avatar_ring"
                    android:padding="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_task_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/tt_surface_elevated"
                        android:contentDescription="Task account avatar"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/TTCircleImage" />
                </FrameLayout>

                <!-- @username -->
                <TextView
                    android:id="@+id/tv_task_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:text="@string/tt_loading_handle"
                    android:textColor="@color/tt_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- Action row: Skip | Follow +N -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_task_skip"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/tt_btn_skip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/tt_skip"
                        android:textColor="@color/tt_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btn_task_follow"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1.6"
                        android:background="@drawable/tt_btn_follow"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_task_follow_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tt_follow"
                            android:textColor="@color/tt_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Coin mark + reward, e.g. "+5" -->
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="Coins"
                            android:src="@drawable/ic_coin"
                            app:tint="@color/tt_gold" />

                        <TextView
                            android:id="@+id/tv_task_reward"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="+5"
                            android:textColor="@color/tt_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ======================= Tips card ======================= -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/tt_card_bg"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header: icon chip + title + collapse chevron -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/tt_icon_chip_bg">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="Tips"
                                android:src="@drawable/ic_tip"
                                app:tint="@color/tt_accent" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/tt_tips"
                            android:textColor="@color/tt_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btn_tips_toggle"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/tt_btn_skip"
                            android:contentDescription="Collapse tips"
                            android:padding="6dp"
                            android:src="@drawable/ic_chevron_up"
                            app:tint="@color/tt_chevron" />
                    </LinearLayout>

                    <!-- Steps + warning (collapsible) -->
                    <LinearLayout
                        android:id="@+id/layout_tips_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <!-- Step 1 | Step 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1"
                                    android:textColor="@color/tt_blue"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/tt_step_click_button"
                                    android:textColor="@color/tt_text_primary"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="2"
                                    android:textColor="@color/tt_blue"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/tt_step_open_app"
                                    android:textColor="@color/tt_text_primary"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 3 | Step 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3"
                                    android:textColor="@color/tt_blue"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/tt_step_give_follow"
                                    android:textColor="@color/tt_text_primary"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="4"
                                    android:textColor="@color/tt_blue"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@string/tt_step_back"
                                    android:textColor="@color/tt_text_primary"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Step 5 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:textColor="@color/tt_blue"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/tt_step_get_coins"
                                android:textColor="@color/tt_text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <!-- Unfollow warning -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/tt_icon_chip_bg">

                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Warning"
                                    android:src="@drawable/ic_warning"
                                    app:tint="@color/tt_tip_red" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/tt_unfollow_warning"
                                android:textColor="@color/tt_tip_red"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ======================= Section 2: your orders ======================= -->
    <!--
      The app's two halves on one screen. Everything above is a task someone else is being
      paid to do; this strip is the buyer's side of the same ledger — the same rows shown
      under More → My orders, so a buyer watching tasks can see what their own order is
      doing without leaving the screen.

      Outside the SwipeRefreshLayout on purpose: pull-to-refresh must not re-trigger while
      the order strip is being scrolled sideways.
    -->
    <LinearLayout
        android:id="@+id/section_task_orders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tt_surface"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tt_task_orders_title"
                android:textColor="@color/tt_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_task_orders_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="3"
                android:textColor="@color/tt_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_task_orders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingStart="20dp"
            android:paddingEnd="10dp"
            tools:listitem="@layout/item_order_task" />

        <TextView
            android:id="@+id/tv_task_orders_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/tt_task_orders_empty"
            android:textColor="@color/tt_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
