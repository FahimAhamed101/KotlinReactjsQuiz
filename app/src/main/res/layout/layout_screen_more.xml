<?xml version="1.0" encoding="utf-8"?>
<!--
  More screen — the account tab.

  Replaced the old two-item AlertDialog so the user can actually see what their
  coins did: the orders they placed and the full coins ledger, including the
  CodeUnlock spends.

  The two lists are RecyclerViews with nested scrolling disabled inside a
  ScrollView. That trades view recycling for a single scroll surface, which is
  the right call here because each list is capped at a page (30 rows).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ======================= Profile card ======================= -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/tt_surface_elevated"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tt_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/tt_avatar_ring"
                        android:padding="3dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_more_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/tt_surface"
                            android:contentDescription="Profile"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/TTCircleImage" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_more_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="@demo_user"
                            android:textColor="@color/tt_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/tt_coin_pill_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="Coins"
                                android:src="@drawable/ic_coin"
                                app:tint="@color/tt_gold" />

                            <TextView
                                android:id="@+id/tv_more_coins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                tools:text="4765 coins"
                                android:textColor="@color/tt_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================= Orders ======================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/tt_more_orders"
                android:textColor="@color/tt_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_orders"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:indeterminateTint="@color/tt_pink"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_orders_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tt_more_no_orders"
                android:textColor="@color/tt_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_my_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:listitem="@layout/item_order_history" />

            <!-- ======================= Coins ledger ======================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/tt_more_coins_history"
                android:textColor="@color/tt_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_coin_history"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:indeterminateTint="@color/tt_pink"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_coin_history_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/tt_more_no_history"
                android:textColor="@color/tt_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_coin_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:listitem="@layout/item_coin_history" />

            <!-- ======================= Actions ======================= -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_more_refresh"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/tt_btn_skip"
                android:stateListAnimator="@null"
                android:text="@string/tt_more_refresh"
                android:textColor="@color/tt_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_more_signout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_outline"
                android:stateListAnimator="@null"
                android:text="@string/tt_more_signout"
                android:textColor="@color/tt_tip_red"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
