<?xml version="1.0" encoding="utf-8"?>
<!--
  Confirm-your-account preview, shown between typing a username and signing in.

  Without it, typing a username told the user nothing about whose account they were about
  to use - and once signed in, a picture that was a placeholder looked exactly like a broken
  one. This is the "is this really me?" check the app had no way to make.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tt_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/tt_preview_title"
        android:textColor="@color/tt_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:background="@drawable/tt_avatar_ring"
        android:padding="6dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_preview_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/tt_surface_elevated"
            android:contentDescription="Profile"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/TTCircleImage" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_preview_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/tt_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="@demo" />

    <TextView
        android:id="@+id/tv_preview_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/tt_text_secondary"
        android:textSize="13sp"
        tools:text="Demo User" />

    <TextView
        android:id="@+id/tv_preview_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/tt_text_secondary"
        android:textSize="12sp"
        tools:text="11 followers  ·  4 following" />

    <!-- Shown when the server answered with its offline placeholder rather than the real
         profile - explaining it beats showing a stranger's face as if it were theirs. -->
    <TextView
        android:id="@+id/tv_preview_missing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/tt_gold"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_preview_not_me"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/tt_btn_skip"
            android:gravity="center"
            android:text="@string/tt_preview_not_me"
            android:textColor="@color/tt_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_preview_continue"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.4"
            android:background="@drawable/tt_btn_pink_pill"
            android:gravity="center"
            android:text="@string/tt_preview_continue"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
