<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_fullscreen_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF020611">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#EB040D1E"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tv_fullscreen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Project Preview"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Counter Pill -->
        <TextView
            android:id="@+id/tv_image_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 3"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/tt_pill_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp" />

        <!-- Close Button -->
        <ImageView
            android:id="@+id/btn_close_fullscreen"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/tt_btn_skip"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Center Content: Fullscreen Image, Loading Spinner, Next/Prev Arrows -->
    <RelativeLayout
        android:id="@+id/layout_image_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF000000"
        android:gravity="center">

        <ImageView
            android:id="@+id/iv_fullscreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Full Screen Screenshot" />

        <ProgressBar
            android:id="@+id/progress_fullscreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/tt_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_fullscreen_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Tap to reload image 🔄"
            android:textColor="@color/tt_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Floating Left Arrow -->
        <ImageView
            android:id="@+id/btn_prev_image"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:padding="11dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/tt_btn_skip"
            android:contentDescription="Previous"
            android:elevation="6dp" />

        <!-- Floating Right Arrow -->
        <ImageView
            android:id="@+id/btn_next_image"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="14dp"
            android:padding="11dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@drawable/tt_btn_skip"
            android:contentDescription="Next"
            android:elevation="6dp" />
    </RelativeLayout>

    <!-- Bottom Thumbnail Strip & Hint -->
    <LinearLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EB040D1E"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="8dp">

        <HorizontalScrollView
            android:id="@+id/scroll_fullscreen_thumbs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_gravity="center_horizontal">

            <LinearLayout
                android:id="@+id/layout_fullscreen_thumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_swipe_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap arrows or thumbnails to navigate • Swipe left/right"
            android:textColor="@color/tt_text_secondary"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

</LinearLayout>