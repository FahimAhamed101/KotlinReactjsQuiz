<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Store Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tt_app_name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tt_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/store_headline"
                    android:textSize="12sp"
                    android:textColor="@color/tt_text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Guarantee Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/tt_btn_skip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/tt_teal"
                    android:contentDescription="Verified" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verified"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/tt_teal"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SocialBoost Pro subscription banner card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sub_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/tt_surface_elevated"
            app:strokeColor="@color/tt_gold"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_sub_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tt_sub_badge"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/tt_gold"
                        android:background="@drawable/tt_btn_skip"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_sub_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$5.00 USD / mo"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tt_teal" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_sub_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tt_sub_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/tt_text_primary"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_sub_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tt_sub_subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/tt_text_secondary"
                    android:layout_marginTop="4dp" />

                <!-- $5 subscription button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_subscribe_5usd"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/tt_btn_follow"
                    android:text="@string/tt_sub_button"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Global purchase restore -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btn_restore_purchases"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↺  Restore my purchases"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/tt_accent"
                android:background="@drawable/btn_outline"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Horizontal Category Filter Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Codes"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/tt_btn_follow"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_filter_fullstack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full-Stack"
                    android:textSize="12sp"
                    android:textColor="@color/tt_text_secondary"
                    android:background="@drawable/tt_btn_skip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_filter_mobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile &amp; Kotlin"
                    android:textSize="12sp"
                    android:textColor="@color/tt_text_secondary"
                    android:background="@drawable/tt_btn_skip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_filter_frontend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="React Frontend"
                    android:textSize="12sp"
                    android:textColor="@color/tt_text_secondary"
                    android:background="@drawable/tt_btn_skip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_filter_backend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Node.js Backend"
                    android:textSize="12sp"
                    android:textColor="@color/tt_text_secondary"
                    android:background="@drawable/tt_btn_skip"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Product List: smooth, full vertical display -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_buy_codes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="32dp"
            tools:listitem="@layout/item_code_product" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
