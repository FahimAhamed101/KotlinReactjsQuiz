    <!--
      Primary accent + the dimmer pressed variant.
      Blue rather than the old hot pink: pink read as a "spend/win now" colour in a store,
      and this app asks people to trust it with an account. Blue is the conventional
      trust colour and it is what the dark navy surfaces were already built around.
      Renamed from `tt_pink` at the same time — a name that said "pink" while holding a blue
      value is a trap for whoever edits this next.
    -->
    <color name="tt_accent">#2563EB</color>
    <color name="tt_accent_dim">#1D4ED8</color>
    <!-- Lighter accent for small text and icons that have to stay legible on navy. -->
    <color name="tt_accent_light">#60A5FA</color>

    <!-- Coin gold -->
    <color name="tt_gold">#FDC90E</color>
    <color name="tt_gift_gold">#FFD51A</color>

