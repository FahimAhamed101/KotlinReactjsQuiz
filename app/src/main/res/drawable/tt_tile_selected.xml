<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected order-type tile. The fill is unchanged and only the border turns cyan,
  which is what the reference app does — so the grid does not visually jump when the
  selection moves.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/tt_surface_elevated" />
    <stroke
        android:width="2dp"
        android:color="@color/tt_teal" />
</shape>
