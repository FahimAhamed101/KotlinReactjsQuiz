<?xml version="1.0" encoding="utf-8"?>
<!--
  Bespoke cosmic glassmorphic card background.
  Linear angled gradient with subtle luminous stroke.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="135"
        android:type="linear"
        android:startColor="@color/card_grad_start"
        android:centerColor="@color/card_grad_mid"
        android:endColor="@color/card_grad_end" />
    <stroke
        android:width="1.2dp"
        android:color="#3360A5FA" />
</shape>
