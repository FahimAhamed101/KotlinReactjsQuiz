<?xml version="1.0" encoding="utf-8"?>
<!--
  Vibrant flame gradient discount tag for boost packages.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="45"
        android:type="linear"
        android:startColor="@color/discount_grad_start"
        android:endColor="@color/discount_grad_end" />
    <padding
        android:left="7dp"
        android:top="2dp"
        android:right="7dp"
        android:bottom="2dp" />
</shape>
