<?xml version="1.0" encoding="utf-8"?>
<!--
  The large preview card on the task screen.

  One shade above the page so it reads as content rather than as a hole, with a hairline
  border because on a #111111 page a #1A1A1A fill is only ~9 levels away and the corners
  otherwise vanish.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@color/tk_surface_alt" />
    <stroke
        android:width="1dp"
        android:color="@color/tk_divider" />
</shape>
