<?xml version="1.0" encoding="utf-8"?>
<!--
  Rounded card used by the Tips panel and other surfaces.

  Indigo -> violet, angled on the diagonal so adjacent cards in a list don't
  share a visible seam. The gradient is deliberately shallow: card text is
  text_secondary (#9AA0B5) and has to stay legible.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="135"
        android:type="linear"
        android:startColor="@color/card_grad_start"
        android:centerColor="@color/card_grad_mid"
        android:endColor="@color/card_grad_end" />
    <stroke
        android:width="1.2dp"
        android:color="#33818CF8" />
</shape>
