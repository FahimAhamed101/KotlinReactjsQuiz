<?xml version="1.0" encoding="utf-8"?>
<!--
  Action chip background (Likes / Views / Shares / Comments on the Video tab).

  Driven by `View.isSelected`, exactly like `tt_order_tile_bg`, so the code only flips
  `isSelected` on the four chips and the framework repaints border and fill.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <!-- A faint cyan wash instead of a full cyan fill: the chips sit right above
                 the link field, and a solid block that bright would pull the eye off it. -->
            <solid android:color="#2200E1E3" />
            <stroke
                android:width="1.5dp"
                android:color="@color/tt_teal" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/tt_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/tt_divider" />
        </shape>
    </item>
</selector>