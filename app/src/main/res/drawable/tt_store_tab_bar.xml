<?xml version="1.0" encoding="utf-8"?>
<!--
  The Profile / Video segmented bar at the top of the Store.

  A dark navy lozenge, deliberately *not* the page background: in the reference the bar
  reads as one rounded slab with the selected half underlined, and the underline has to
  look like it belongs to the slab rather than floating on the page.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="#0F1B2F" />
    <stroke
        android:width="1dp"
        android:color="#1B2A45" />
</shape>
