<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+).

  foreground: the supplied 1024x1024 artwork with transparent corners, so the
              launcher can mask/scale it into any shape (circle, squircle, …).
  background: the artwork's own background colour (#0A073C), sampled from the
              corner pixels of the legacy square, so the adaptive icon and the
              pre-API-26 square look identical.

  monochrome: Android 13+ themed icons. Reusing the foreground keeps the
              silhouette (shopping bag + growth arrow) recognisable in a
              single flat colour.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
